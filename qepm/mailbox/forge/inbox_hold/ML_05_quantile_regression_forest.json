  "design": {
    "concept": "RF가 평균 수익률만 예측하는 것과 달리, QRF는 수익률 분포 전체 예측. 5th percentile(=CVaR proxy) 높은(=좌측 꼬리 작은) 종목 선정 → MDD 직접 최소화.",
    "logic": [
      "1. Features: 7팩터 z-score + trailing vol + trailing MDD per stock",
      "2. Target: next month return",
      "3. QRF 학습 (expanding walk-forward)",
      "4. 예측 분포의 5th percentile(Q5) 추출",
      "5. selection_score = 0.5 * E[return] + 0.5 * (-Q5_loss)",
      "6. Top 30 by selection_score → EW"
    ],
    "overlay": "DD_med only + regime_engine_daily.R + VT 0.25"
  },
  "pit_rules": {"C1": "학습 1~(t-1)월", "C12": "시계열 walk-forward"},
