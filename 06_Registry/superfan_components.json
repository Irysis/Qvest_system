     "patterns": [
      {"severity": "fail", "regex": "^Error in |Execution halted", "label": "R 오류"},
      {"severity": "fail", "regex": "측정 무효|처치 미전달|침묵 부분측정", "label": "측정 무효"},
      {"severity": "fail", "regex": "R2 가드|등록 거부|재결정 거부", "label": "사전등록 가드"}]}
   ]
  },
  {
