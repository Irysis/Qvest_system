   "knowledge": ["memory:project-catalog-cap-post-hoc-silent-date-drop-and-p3r01-eval-cdar-20261015.md", "memory:project-l1-round1-results-and-speed-20261015.md"],
   "rules": [
    {"id": "pipeline_errors", "kind": "log_patterns",
