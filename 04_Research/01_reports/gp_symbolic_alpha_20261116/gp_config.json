{
  "version": "gpa_v1",
  "frozen_at": "2026-11-16",
  "note": "모든 수치는 측정 전 고정. 근거 = README.md 각 절. 2023~ 성과로 이 파일의 어떤 값도 고르지 않는다(tau_D).",
  "data": {
    "rawdata": ".cache/RAWDATA.parquet",
    "fund_q": ".cache/fundamental_quarterly.parquet",
    "benchmark": ".cache/benchmark.parquet",
    "benchmark_src": "quantiwise_iks200",
    "rf": ".cache/ecos_bond_rates.parquet",
    "rf_series": "KR_CD91",
    "history_buffer_start": "1998-01-01",
    "fitness_start": "2000-01-01",
    "fund_items_ttm": ["NetIncomeParent", "OperatingProfit", "Revenue", "GrossProfit", "OperatingCF"],
    "fund_items_bal": ["BookEquity", "TotalAssets", "TotalLiab"],
    "fund_max_age_months": 15
  },
  "universe": {
    "excluded_flags": ["AdminStock", "TradingHalt", "UnfaithfulDisc"],
    "liq_min_krw": 2e8,
    "adv_window": 20,
    "price_floor_krw": 1000,
    "lag_days": 1
  },
  "portfolio": {
    "top_n": 25,
    "weighting": "equal",
    "long_only": true,
    "cost_one_way": 0.0015,
    "min_names": 5,
    "rebalance": "monthly_last_trading_day"
  },
  "grammar": {
    "terminals_price": ["open", "high", "low", "close", "volume", "amount", "ret", "cap"],
    "windows": [5, 10, 20, 60, 120, 250],
    "unary": ["neg", "abs", "slog", "ssqrt", "cs_rank", "cs_zscore"],
    "binary": ["add", "sub", "mul", "div"],
    "ts_unary": ["ts_mean", "ts_std", "ts_rank", "ts_min", "ts_max", "ts_delta", "ts_delay", "ts_decay_linear"],
    "ts_binary": ["ts_corr", "ts_cov"],
    "max_depth": 5,
    "max_nodes": 20,
    "init_depth": [1, 3],
    "ts_min_count_frac": 0.75,
    "div_eps": 1e-10,
    "winsor_q": [0.01, 0.99],
    "winsor_after": ["mul", "div", "ts_delta"],
    "winsor_inputs": ["ret", "fund_*"]
  },
  "fitness": {
    "objective": "alpha_ir",
    "alpha_model": "capm_excess_rf_cd91",
    "parsimony_per_node": 0.005,
    "std_factor_corr_free": 0.7,
    "std_factor_corr_penalty": 1.0,
    "coverage_min": 0.6,
    "invalid_fitness": -10.0,
    "diag_only": ["excess_ir", "beta", "rank_ic_mean", "rank_ic_t", "turnover", "max_single_contrib"]
  },
  "selection": {
    "rule": "val_alpha_ir_rank_greedy_decorrelated",
    "k": 5,
    "corr_max_vs_std": 0.7,
    "corr_max_vs_selected": 0.7,
    "require_train_alpha_ir_pos": true,
    "require_val_alpha_ir_pos": true,
    "composite": "equal_weight_mean_of_cs_pct_rank",
    "max_single_contrib_in_rule": false
  },
  "walkforward": {
    "val_months": 36,
    "embargo_months": 1,
    "min_window_years": 8,
    "first_evolution_year_end": 2007,
    "last_evolution_year_end": 2025,
    "variants": {
      "EXP": {"window": "expanding"},
      "ROLL8": {"window": "rolling", "years": 8}
    },
    "inherit_frac": 0.2
  },
  "evolution": {
    "population": 300,
    "generations": 15,
    "tournament": 7,
    "p_crossover": 0.6,
    "p_mutation": 0.3,
    "hall_of_fame": 50,
    "seed": 20261116
  },
  "resources": {
    "max_workers": 4,
    "max_rss_gb": 4.0,
    "subtree_cache_mb": 900,
    "dtype": "float32"
  },
  "smoke": {
    "history_buffer_start": "2003-01-01",
    "fitness_start": "2005-01-01",
    "data_end": "2011-12-31",
    "n_tickers": 400,
    "ticker_pick": "random_among_eligible_on_2004-12-30",
    "min_window_years": 4,
    "val_months": 12,
    "first_evolution_year_end": 2008,
    "last_evolution_year_end": 2010,
    "rolling_years": 3,
    "population": 60,
    "generations": 4,
    "hall_of_fame": 15
  }
}
