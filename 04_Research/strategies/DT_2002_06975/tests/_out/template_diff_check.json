      "replaced": ["def synthetic_check(seed, m):", "    # positive control: a known rank-target structure must be learned by the same fit_predict routine", "    rng = np.random.default_rng(seed)", "    n, npred = 20000, 5000", "    X = rng.uniform(0.0, 1.0, size=(n, m)).astype(np.float32)", "    w = rng.normal(size=m).astype(np.float32)", "    f = X @ w + 0.5 * np.sin(6.0 * X[:, 0])", "    y = (pd.Series(f).rank(method=\"average\") / n).to_numpy(dtype=np.float32)", "    Xp = rng.uniform(0.0, 1.0, size=(npred, m)).astype(np.float32)", "    fp = Xp @ w + 0.5 * np.sin(6.0 * Xp[:, 0])", "    pred, steps, skipped, last = fit_predict(X, y, Xp, seed)", "    rho = float(pd.Series(pred).corr(pd.Series(fp), method=\"spearman\"))", "    return rho, steps"]
