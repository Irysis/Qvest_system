      "replaced": ["def cache_read(key):", "    p = os.path.join(CACHE_DIR, key + \".npz\")", "    if not os.path.exists(p):", "        return None", "    try:", "        z = np.load(p, allow_pickle=False)", "        return dict(score=z[\"score\"].astype(np.float64), tk=z[\"tk\"].astype(str), steps=int(z[\"steps\"]),", "                    skipped=int(z[\"skipped\"]), last_loss=float(z[\"last_loss\"]), secs=float(z[\"secs\"]),", "                    device=str(z[\"device\"]), source=str(z[\"source\"]))", "    except Exception:", "        return None", "", "", "def cache_write(key, score, tk, steps, skipped, last_loss, secs, device, source):", "    p = os.path.join(CACHE_DIR, key + \".npz\")", "    tmp = os.path.join(CACHE_DIR, \"%s.%d.tmp.npz\" % (key, os.getpid()))", "    np.savez(tmp, score=np.asarray(score, dtype=np.float64), tk=np.asarray(tk, dtype=str),", "             steps=np.int64(steps), skipped=np.int64(skipped), last_loss=np.float64(last_loss),", "             secs=np.float64(secs), device=np.str_(device), source=np.str_(source))", "    os.replace(tmp, p)"]
