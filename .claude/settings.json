{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch",
      "WebFetch(*)",
      "Agent(*)",
      "Skill(*)",
      "NotebookEdit(*)",
      "mcp__jina__search_web",
      "mcp__jina__read_url",
      "mcp__jina__search_arxiv",
      "mcp__jina__search_ssrn",
      "mcp__jina__expand_query",
      "mcp__jina__parallel_search_web",
      "mcp__jina__parallel_read_url",
      "mcp__jina__parallel_search_arxiv",
      "mcp__jina__parallel_search_ssrn",
      "mcp__arxiv__search_papers",
      "mcp__arxiv__read_paper",
      "mcp__arxiv__download_paper",
      "mcp__arxiv__list_papers",
      "mcp__paper-search__search_arxiv",
      "mcp__paper-search__search_google_scholar",
      "mcp__paper-search__read_arxiv_paper",
      "mcp__paper-search__download_arxiv",
      "mcp__fred__get_series",
      "mcp__fred__search_series",
      "mcp__yfinance__get_price_history",
      "mcp__yfinance__get_ticker_info",
      "mcp__rss-reader__fetch_feed_entries"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "_doc_phase_c3": "fast→slow 순서: safety_guard <50ms → axiom <300ms → forge_code_guard <100ms (Phase C1 daemon 분리 후)",
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/safety_guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/axiom_enforcement_hook.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/unified_agent_guard.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/role_taxonomy_admission_gate.sh\" 2>>/tmp/role_taxonomy_gate.log || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/pipeline_trigger.sh\" >> /tmp/pipeline_trigger.log 2>&1 || true"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/milestone_commit.sh\" 2>>/tmp/milestone_commit.log || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/auto_commit_on_stop.sh\" 2>>/tmp/auto_commit.log || true"
          }
        ]
      }
    ],
    "FileChanged": [],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/teammate_idle_guard.sh\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIR=$(ls -d /mnt/c/Users/*/OneDrive/바탕\\ 화면/Quant_Module_Moltbot 2>/dev/null | head -1 || echo \"$PWD\"); bash \"$DIR/02_Infrastructure/hooks/task_complete_guard.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  }
}