      "mcp__yfinance__yfinance_get_ticker_info",
      "mcp__rss-reader__fetch_feed_entries"
    ],
    "defaultMode": "acceptEdits"
  },
  "skillOverrides": {
    "alpha-research": "user-invocable-only",
    "risk-research": "user-invocable-only",
    "optimizer-research": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "_doc_v9": "v9 lean loop 2026-08-23: router dispatch retired. v10 2026-08-29: 자본 게이트 개념 폐지 — 남은 것은 측정 규율(graduation HARD 3종)·고정축·보호선·PIT. unregistered hooks are listed in 02_Infrastructure/hooks/_archive_v8_enforcement/MANIFEST.md (filenames intentionally not listed here)",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/safety_guard.sh\""
          },
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/legacy_write_block.sh\" 2>>/tmp/legacy_write_block.log || true"
          },
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/book_write_guard.sh\" 2>>/tmp/book_write_guard.log || true"
          }
        ]
      },
      {
        "_doc_measurement_gates": "측정 규율 게이트 2종 — graduation HARD 3종(PORT_t≥2.95·oos_retention≥0.7·Calmar≥0.64 = essence A 문턱의 부분집합) fail-closed + 고정축(≤25종·long-only·Σw=1 — 종목별 비중 상한은 v10 폐지) 강제. 둘 다 stdout JSON decision:block 으로 차단하므로 '|| true' 는 exit code 만 무시한다(차단력 불변).",
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/discovery_graduation_gate.sh\" 2>>/tmp/discovery_graduation.log || true"
          },
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/worktask_constraint_enforcer.sh\""
          }
        ]
      },
      {
        "_doc_bt_contract": "★2026-08-24 재등록 — 원장 integrity 게이트. 2026-08-23 플랜 D-d 로 해제됐던 사유는 이 임무가 아니라 .py 자체합성 idiom 차단의 오탐(v8.4 ML 레인)이었고, 그 가지만 제거했다. 재등록 전 양성/음성/돌연변이 대조 10/10 실증 = 08_Tests/hooks/test_backtest_contract_audit_gate.R. ★수리 중 발견: 구판은 여러 줄 Rscript -e 가 이 환경에서 rc=139 로 죽어 ERR trap → fail-closed 로만 반응했다 = 판정 코드가 한 번도 실행된 적이 없다. python-policy.md 의 자체합성 금지 룰은 텍스트로 존치하며 이 훅이 강제하지 않을 뿐이다.",
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/backtest_contract_audit.sh\""
          }
        ]
      },
      {
        "_doc_bash_guards": "Bash 경로 보호선 — 생산 폴더 쓰기 차단 + 텔레그램 직접 호출 차단(tg_agent_brief 단일 진입점 강제).",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/safety_guard.sh\""
          },
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/telegram_direct_call_guard.sh\""
          }
        ]
      },
      {
        "_doc_agent_inject": "에이전트 스폰 시 공리·고정축 컨텍스트 주입 (context only, 차단 없음).",
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/axiom_context_inject.sh\""
          }
        ]
      },
      {
        "_doc_arm_gen_read_guard": "arm 생성 세션(QVEST_ARM_GEN=1)에서 측정 산출물 Read/Grep 차단 — 생성기는 성과를 보지 않는다. 평시 무발화.",
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/arm_gen_read_guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_doc_post_v10": "v10 2026-08-29: governor_concord_certifier 등록 해제(governor 폐지 — 감시 대상 소멸, 승계 훅 = PreToolUse book_write_guard.sh). PostToolUse 는 PIT C5 오버레이 advisory 1종만 유지.",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/overlay_pit_grep.sh\" 2>>/tmp/overlay_pit_grep.log || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "_doc_boot_canary": "2026-07-17 B2 부트 카나리아 — 부트스탬프 부재/24h+ stale 시 '/qvest 권장' 컨텍스트 경고. warn-only.",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/boot_stamp_check.sh\" 2>>/tmp/boot_stamp_check.log || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "_doc_session_end": "v9 2026-08-23: 구 Stop 등록에서 이동 — 턴당이 아니라 세션당 1회 커밋/푸시. Stop 이벤트는 등록 0(차단 훅 없음).",
        "hooks": [
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/auto_commit_on_stop.sh\" 2>>/tmp/auto_commit_on_stop.log || true",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "DIR=${CLAUDE_PROJECT_DIR:-${QM_ROOT:-$PWD}}; bash \"$DIR/02_Infrastructure/hooks/auto_push_on_stop.sh\" 2>>/tmp/auto_push_on_stop.log || true",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}