{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qvest://worktask/schema/v1",
  "title": "QEPM Work Task Schema v1",
  "description": "1 Work Task = QEPM Full Pipeline 1회 = 1 리서치 사이클. Alpha → Risk → Optimizer 3-agent 순차 실행 후 Forge 통합 → Judge 검증 → Governor admission.",

  "definitions": {
    "work_task_request": {
      "type": "object",
      "required": [
        "task_id", "wt_type", "as_of_date", "forecast_horizon", "rebalance_frequency",
        "universe_definition", "benchmark_definition",
        "data_lag_rules", "cost_model_version",
        "hard_constraints"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^WT-[DPSH][0-9]{8}_[0-9]{3}$", "description": "WT-D = Discovery, WT-P = Deployment, WT-S = Sizing-only, WT-H = Hyperparameter-sweep (v1.2)"},
        "wt_type": {
          "type": "string",
          "enum": ["discovery", "deployment", "sizing_only", "hyperparameter_sweep"],
          "description": "v1.2 Charter §10: discovery=신규 alpha 발굴 / deployment=검증 alpha 편성 / sizing_only=parent inheritance audit + sizing rationale (alpha 0건 정상) / hyperparameter_sweep=parent alpha 동일 + grid sweep만. sizing_only/hyperparameter_sweep은 alpha_discovery_certificate 미발급 → PG1 admission 자격 없음."
        },
        "pg1_eligibility": {
          "type": "string",
          "enum": ["certificate_required", "eligible", "deployment_track"],
          "description": "v1.2 Charter §10: certificate_required = alpha_discovery_certificate 발급 필요 (sizing_only/hyperparameter_sweep), eligible = certificate 발급 받음, deployment_track = 검증된 alpha 직접 편성"
        },
        "discovery_of": {
          "type": ["string", "null"],
          "description": "Deployment WT만: 어떤 Discovery WT의 결과를 채택하는지 back-ref (예: WT-D20260423_001)"
        },
        "alpha_discovery_certificate": {
          "type": "object",
          "description": "v1.2 Charter §10: alpha_discovery_certifier.sh 발급. 미발급이면 PG1 admission 자격 박탈.",
          "properties": {
            "issued": {"type": "boolean"},
            "inheritance_cor_actual": {"type": "number", "minimum": 0, "maximum": 1.001},
            "inheritance_cor_max": {"type": "number", "default": 0.95},
            "mechanism_cited": {"type": "string", "minLength": 50},
            "factor_specs_new_count": {"type": "integer", "minimum": 0},
            "harvey_t_specs_pass_count": {"type": "integer", "minimum": 0},
            "issued_at": {"type": "string", "format": "date-time"},
            "non_issuance_reason": {"type": ["string", "null"], "description": "미발급 사유 (cor>=0.95 / mechanism<50chars / factor_specs=0 / harvey_t pass<3)"}
          }
        },
        "graduation_criteria": {
          "type": "object",
          "description": "Discovery → Deployment 전환 조건. wt_type=discovery 의무.",
          "properties": {
            "min_rank_ic": {"type": "number", "minimum": 0},
            "min_icir": {"type": "number", "minimum": 0},
            "min_subperiod_stability": {"type": "number", "minimum": 0, "maximum": 1},
            "max_drawdown_days": {"type": "integer"}
          }
        },
        "theme": {"type": "string", "maxLength": 200, "description": "주제 레벨 (예: 'Defense family 강화'). Alpha Agent가 Step 0에서 가설 자동 발굴 모드. hypothesis_title 있으면 무시."},
        "hypothesis_title": {"type": ["string", "null"], "maxLength": 200, "description": "구체 가설. null이면 Alpha Agent Step 0 Hypothesis Discovery 활성화."},
        "hypothesis_description": {"type": "string"},
        "hypothesis_source": {"type": "string", "enum": ["user_defined", "alpha_agent_discovered"], "description": "user_defined = 사용자 지정 / alpha_agent_discovered = Step 0 자동 발굴"},
        "as_of_date": {"type": "string", "format": "date"},
        "forecast_horizon": {"type": "string", "enum": ["1M", "3M", "6M", "12M"]},
        "rebalance_frequency": {"type": "string", "enum": ["weekly", "monthly", "quarterly"]},
        "evaluation_windows": {
          "type": "object",
          "description": "R2 Nested Evaluation — 4단계 split. Alpha/Risk/Optimizer는 train+val만 접근, Judge는 lockbox만 접근.",
          "required": ["train_window", "validation_window", "lockbox_window"],
          "properties": {
            "train_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}}},
            "validation_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}}},
            "lockbox_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}, "sealed": {"type":"boolean"}}},
            "paper_trade_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}}}
          }
        },
        "method_shopping_log_ref": {"type": "string", "description": "path to method_shopping_log.json"},
        "universe_definition": {
          "type": "object",
          "required": ["label", "liquidity_min_won_20d_avg", "max_names_total"],
          "properties": {
            "label": {"type": "string", "enum": ["KOSPI200", "KOSDAQ150", "KOSPI200_KOSDAQ150_intersection", "KR_top500"]},
            "liquidity_min_won_20d_avg": {"type": "number", "minimum": 100000000},
            "max_names_total": {"type": "integer", "maximum": 500}
          }
        },
        "benchmark_definition": {"type": "string"},
        "data_lag_rules": {
          "type": "object",
          "required": ["fundamental", "price", "investor_flow", "macro"],
          "properties": {
            "fundamental": {"type": "string", "pattern": ".*(45d|monthly|quarterly).*"},
            "price": {"type": "string"},
            "investor_flow": {"type": "string"},
            "macro": {"type": "string"}
          }
        },
        "cost_model_version": {"type": "string", "pattern": "^v[0-9.]+_.+_[0-9]+bps$"},
        "current_portfolio": {"type": "string", "description": "현 PG2 reference"},
        "hard_constraints": {
          "type": "object",
          "required": ["max_names", "weight_bounds", "liquidity_min_won_20d_avg"],
          "properties": {
            "max_names": {"type": "integer", "maximum": 25, "description": "Hard cap 25 (user rule, 도훈 mandate 2026-05-29 20→25)"},
            "weight_bounds": {
              "type": "array",
              "minItems": 2, "maxItems": 2,
              "items": {"type": "number"},
              "description": "[min, max]. Long-only면 [0, 0.20]"
            },
            "sector_active_weight_cap": {"type": "number", "minimum": 0, "maximum": 0.30},
            "liquidity_min_won_20d_avg": {"type": "number", "minimum": 200000000}
          }
        },
        "soft_penalties": {
          "type": "object",
          "properties": {
            "turnover_cap_annual": {"type": "number", "minimum": 0, "maximum": 12},
            "beta_target": {"type": "number"},
            "style_exposure_cap": {"type": "number"}
          }
        },
        "capacity_limits": {
          "type": "object",
          "properties": {
            "adv_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
            "capacity_max_aum_won": {"type": "number"}
          }
        }
      }
    },

    "alpha_package": {
      "type": "object",
      "description": "Alpha Agent 산출물. 기대초과수익 α̂만.",
      "required": ["task_id", "as_of_date", "forecast_horizon", "alpha_vector", "factor_specs", "diagnostics"],
      "properties": {
        "task_id": {"type": "string"},
        "as_of_date": {"type": "string", "format": "date"},
        "forecast_horizon": {"type": "string"},
        "alpha_vector": {
          "type": "object",
          "description": "Ticker → expected active return (decimal)",
          "additionalProperties": {"type": "number"}
        },
        "confidence_vector": {
          "type": "object",
          "description": "Ticker → confidence [0,1]",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "signal_matrix_ref": {"type": "string", "description": "feature_store:// 경로"},
        "factor_specs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["factor_family", "proxy", "economic_rationale"],
            "properties": {
              "factor_family": {"type": "string", "description": "Value/Quality/Momentum/Size 등 family"},
              "proxy": {"type": "string", "description": "B/P, ROE, RSI 등 실제 변수"},
              "formula": {"type": "string"},
              "lag_rule": {"type": "string"},
              "winsorization": {"type": "string"},
              "neutralization": {"type": "string", "examples": ["none", "sector", "size", "sector+size"]},
              "economic_rationale": {"type": "string", "enum": ["risk_premium", "behavioral", "structural"]},
              "weight_theta": {"type": "number"},
              "references": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "diagnostics": {
          "type": "object",
          "required": ["rank_ic", "alpha_inheritance_cor"],
          "properties": {
            "rank_ic": {"type": "number"},
            "icir": {"type": "number"},
            "monotonicity": {"type": "number"},
            "subperiod_stability": {"type": "number"},
            "turnover_proxy": {"type": "number"},
            "harvey_t_stat": {"type": "number"},
            "harvey_t_specs_pass_count": {"type": "integer", "minimum": 0, "description": "v1.2 Charter §10: 5-spec FF/Carhart/CAPM Harvey t > 3.0 통과 갯수"},
            "deflated_sharpe_ratio": {"type": "number"},
            "post_neutralization_ic": {"type": "number"},
            "alpha_inheritance_cor": {"type": "number", "minimum": 0, "maximum": 1.001, "description": "v1.2 Charter §10: parent strategy alpha와의 cosine/correlation. 0 = 완전 신규, 1 = 완벽 동일. > 0.95이면 alpha_discovery_certificate 미발급."}
          }
        },
        "alpha_discovery_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "v1.2 Charter §10 Role Card: 본 WT가 발견한 신규 alpha 개수. wt_type=sizing_only/hyperparameter_sweep 시 0 expected."
        },
        "selection_objective": {
          "type": "string",
          "enum": ["rank_ic", "icir", "monotonicity", "subperiod_stability"],
          "description": "R4 P3: Alpha Agent는 predictive power만 기준으로 선택. SR/CAGR/MDD 직접 금지."
        },
        "challenge_flags": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },

    "risk_package": {
      "type": "object",
      "description": "Risk Agent 산출물. 공분산 Σ = BΩB' + D + stress 진단.",
      "required": ["task_id", "as_of_date", "factor_covariance_ref", "specific_risk_ref", "security_covariance_ref", "risk_summary", "diagnostics"],
      "properties": {
        "task_id": {"type": "string"},
        "as_of_date": {"type": "string", "format": "date"},
        "exposure_matrix_ref": {"type": "string", "description": "B 행렬 parquet 경로"},
        "factor_covariance_ref": {"type": "string", "description": "Ω 행렬"},
        "specific_risk_ref": {"type": "string", "description": "D 대각행렬"},
        "security_covariance_ref": {"type": "string", "description": "Σ 행렬"},
        "risk_summary": {
          "type": "object",
          "required": ["top_common_risks", "stress_tests"],
          "properties": {
            "top_common_risks": {
              "type": "array",
              "items": {"type": "string"},
              "description": "상위 공통 위험 순위"
            },
            "crowding_flags": {"type": "array", "items": {"type": "string"}},
            "liquidity_flags": {"type": "array", "items": {"type": "string"}},
            "stress_tests": {
              "type": "object",
              "properties": {
                "market_down_5": {"type": "number"},
                "value_crash": {"type": "number"},
                "momentum_reversal": {"type": "number"},
                "gfc_2008": {"type": "number"},
                "eudebt_2011": {"type": "number"},
                "covid_2020": {"type": "number"},
                "rate_2022": {"type": "number"}
              }
            }
          }
        },
        "diagnostics": {
          "type": "object",
          "required": ["condition_number", "shrinkage_used"],
          "properties": {
            "condition_number": {"type": "number"},
            "shrinkage_used": {"type": "boolean"},
            "shrinkage_method": {"type": "string", "enum": ["none", "ledoit_wolf", "gerber", "rmt_filtered", "dcc_copula"]},
            "factor_correlation_warnings": {"type": "array", "items": {"type": "string"}},
            "tdc_summary": {"type": "object"},
            "regime_correlation_ref": {"type": "string"}
          }
        },
        "selection_objective": {
          "type": "string",
          "enum": ["condition_number", "stress_robust", "crowding", "shrinkage_quality"],
          "description": "R4 P3: Risk Agent는 estimation quality만 기준. alpha/return 기반 선택 금지."
        },
        "challenge_flags": {"type": "array", "items": {"type": "string"}}
      }
    },

    "optimization_package": {
      "type": "object",
      "description": "Optimizer Agent 산출물. target_weights + method + infeasibility.",
      "required": ["task_id", "as_of_date", "method_selected", "expected_tracking_error"],
      "properties": {
        "task_id": {"type": "string"},
        "as_of_date": {"type": "string", "format": "date"},
        "target_weights": {
          "type": "object",
          "description": "Ticker → absolute weight [0, 0.20]. Σw = 1.",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 0.20},
          "maxProperties": 20
        },
        "active_weights": {
          "type": "object",
          "description": "Ticker → active weight (vs benchmark). Σw = 0.",
          "additionalProperties": {"type": "number"}
        },
        "expected_active_return": {"type": "number"},
        "expected_tracking_error": {"type": "number", "minimum": 0},
        "expected_information_ratio": {"type": "number"},
        "turnover": {"type": "number", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0},
        "binding_constraints": {"type": "array", "items": {"type": "string"}},
        "infeasibility_report": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["reason", "violated_constraints"]}
          ]
        },
        "method_selected": {"type": "string", "description": "예: MVO_lambda_1.5_cost_phi_0.8"},
        "method_comparison": {
          "type": "object",
          "description": "방법론별 SR/TE/IR 비교표 (method_shopping_log와 연계)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ir": {"type": "number"},
              "te": {"type": "number"},
              "sr": {"type": "number"},
              "turnover": {"type": "number"},
              "cost": {"type": "number"}
            }
          }
        },
        "selection_objective": {
          "type": "string",
          "enum": ["net_ir", "to_adj_ret", "uncertainty_penalty", "crowding_adj_ret"],
          "description": "R4 P3: Optimizer Agent는 net_ir / turnover-adjusted 기준만. SR 단일 최대화 금지."
        },
        "explanation": {
          "type": "object",
          "properties": {
            "top_overweights": {"type": "array", "items": {"type": "string"}},
            "top_underweights": {"type": "array", "items": {"type": "string"}},
            "main_tradeoffs": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },

    "forge_package": {
      "type": "object",
      "description": "Forge Agent 산출물. weights.csv → daily share-based NAV reconstruction. Charter §9 SoT — PG2 admission grade SR 유일 source.",
      "required": [
        "task_id", "as_of_date", "method",
        "sr_realized_share_based",
        "measurement_basis_primary",
        "weights_csv_unique_dates_count",
        "alpha_sig_dates_count",
        "schedule_density_ratio",
        "schedule_density_pass",
        "pure_function_violation"
      ],
      "properties": {
        "task_id": {"type": "string"},
        "as_of_date": {"type": "string", "format": "date"},
        "method": {
          "type": "string",
          "pattern": "weights\\.csv.*NAV.*",
          "description": "예: 'weights.csv_direct_NAV_reconstruction' — Charter §9 위반 표현 (ProductionSchedule[N]m 등) 금지"
        },
        "sr_realized_share_based": {
          "type": "number",
          "description": "PG2 admission grade SR (weights.csv → daily share-based NAV → 15bps cost)"
        },
        "sr_factor_engine_continuous": {
          "type": ["number", "null"],
          "description": "alpha signal strength meta only. PG2 admission 부적격."
        },
        "sr_lockbox_daily_harness": {
          "type": ["number", "null"],
          "description": "judge_lockbox_harness.R cross-validation"
        },
        "measurement_basis_primary": {
          "type": "string",
          "enum": ["forge_realized_share_based"],
          "description": "Charter §9 SoT — primary는 항상 forge_realized_share_based"
        },
        "weights_csv_unique_dates_count": {"type": "integer", "minimum": 1},
        "alpha_sig_dates_count": {"type": "integer", "minimum": 1},
        "schedule_density_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.05,
          "description": "weights_csv_unique_dates_count / alpha_sig_dates_count"
        },
        "schedule_density_pass": {
          "type": "boolean",
          "description": "schedule_density_ratio ≥ 0.95"
        },
        "pure_function_violation": {
          "type": "boolean",
          "description": "true 시 run_all.R이 alpha_scores 직접 top-N selection 사용 — Charter §9 violation"
        },
        "divergence_factor_engine_vs_realized_pp": {
          "type": ["number", "null"],
          "description": "sr_factor_engine_continuous - sr_realized_share_based (양수 = factor_engine inflate)"
        },
        "vs_factor_engine": {
          "type": "object",
          "description": "factor_engine claim vs forge realized 정직 비교 — Charter §8/§9 mandatory disclosure",
          "properties": {
            "factor_engine_claimed_sr_is": {"type": "number"},
            "forge_v3_realized_sr_is": {"type": "number"},
            "divergence_pp": {"type": "number"},
            "diagnosis": {
              "type": "string",
              "enum": ["NEGLIGIBLE", "MINOR_DRIFT", "SIGNIFICANT_DRAG", "FABRICATION_SUSPECTED"],
              "description": "auto rule: |·|<0.1 NEGLIGIBLE / 0.1-0.3 MINOR_DRIFT / 0.3-0.6 SIGNIFICANT_DRAG / ≥0.6 FABRICATION_SUSPECTED"
            }
          }
        },
        "backtest_summary": {
          "type": "object",
          "properties": {
            "full_period": {"type": "object"},
            "pre_lockbox": {"type": "object"},
            "lockbox": {"type": "object"}
          }
        },
        "factor_regression_5_specs": {
          "type": "object",
          "description": "CAPM / FF3 / FF5 / Carhart4 / FF5+Mom Harvey NW-HAC t-stats"
        },
        "hard_caps": {
          "type": "object",
          "properties": {
            "mdd_pass": {"type": "boolean"},
            "to_pass": {"type": "boolean"},
            "cvar_d_pass": {"type": "boolean"},
            "all_pass": {"type": "boolean"}
          }
        },
        "hash_audit_pass": {"type": "boolean"}
      }
    },

    "hurdle_result": {
      "type": "object",
      "description": "Optimizer/Forge intermediate result. Charter §9 — production_grade=true는 forge_realized_share_based만.",
      "required": ["task_id", "method", "method_basis_label", "production_grade"],
      "properties": {
        "task_id": {"type": "string"},
        "method": {
          "type": "string",
          "description": "Charter §9: 'ProductionSchedule[N]m' 표현 금지 (fabrication label)"
        },
        "method_basis_label": {
          "type": "string",
          "enum": [
            "optimizer_walk_forward_simulation",
            "factor_engine_continuous",
            "forge_realized_share_based"
          ]
        },
        "production_grade": {
          "type": "boolean",
          "description": "true는 forge_realized_share_based만. factor_engine_continuous = false."
        }
      }
    },

    "execution_package": {
      "type": "object",
      "description": "R8 Execution Agent 산출물. Deployment WT의 target_weights → 주문 분할 + impact 추정.",
      "required": ["task_id", "rebalance_date", "trade_list", "schedule"],
      "properties": {
        "task_id": {"type": "string"},
        "rebalance_date": {"type": "string", "format": "date"},
        "trade_list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ticker", "side", "shares"],
            "properties": {
              "ticker": {"type": "string"},
              "side": {"type": "string", "enum": ["buy", "sell"]},
              "shares": {"type": "integer", "minimum": 0},
              "target_weight": {"type": "number", "minimum": 0, "maximum": 0.20},
              "current_weight": {"type": "number"}
            }
          }
        },
        "schedule": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "enum": ["single_shot", "TWAP", "VWAP", "POV"]},
            "duration_hours": {"type": "number"},
            "participation_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "start_time": {"type": "string"},
            "end_time": {"type": "string"}
          }
        },
        "impact_estimate_bps": {
          "type": "object",
          "properties": {
            "avg": {"type": "number"},
            "worst_ticker": {"type": "string"},
            "worst_bps": {"type": "number"}
          }
        },
        "expected_slippage_bps": {"type": "number"},
        "capacity_warnings": {"type": "array", "items": {"type": "string"}},
        "method": {"type": "string"}
      }
    },

    "monitoring_report": {
      "type": "object",
      "description": "R9 Monitoring Agent 산출물. admitted WT realized vs predicted drift.",
      "required": ["monitoring_month", "admitted_wts_monitored", "per_wt_results"],
      "properties": {
        "monitoring_month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "admitted_wts_monitored": {"type": "array", "items": {"type": "string"}},
        "per_wt_results": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "alpha_predicted": {"type": "number"},
              "alpha_realized": {"type": "number"},
              "alpha_ratio": {"type": "number"},
              "te_predicted": {"type": "number"},
              "te_realized": {"type": "number"},
              "te_ratio": {"type": "number"},
              "crowding_now": {"type": "number"},
              "crowding_3m_ago": {"type": "number"},
              "crowding_drift": {"type": "number"},
              "ic_3m": {"type": "number"},
              "ic_12m": {"type": "number"},
              "ic_decay_ratio": {"type": "number"},
              "regime_cached": {"type": "string"},
              "regime_current": {"type": "string"},
              "alerts": {"type": "array", "items": {"type": "string"}},
              "action_requested": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "book_level": {
          "type": "object",
          "properties": {
            "aggregate_alpha_ratio": {"type": "number"},
            "aggregate_te_ratio": {"type": "number"},
            "highest_alert_count_wt": {"type": "string"}
          }
        },
        "telegram_sent": {"type": "boolean"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },

    "governance_log": {
      "type": "object",
      "description": "Work Task 내 결정 이력",
      "properties": {
        "task_id": {"type": "string"},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "agent", "action", "summary"],
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "agent": {"type": "string", "enum": ["alpha", "risk", "optimizer", "forge", "judge", "governor", "execution", "monitoring", "q-lead"]},
              "action": {"type": "string"},
              "summary": {"type": "string"},
              "challenge_notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },

    "artifact_lineage": {
      "type": "object",
      "description": "R11 Artifact lineage + reproducibility. Each package write appends an entry.",
      "required": ["task_id", "entries"],
      "properties": {
        "task_id": {"type": "string"},
        "schema_version": {"type": "string"},
        "last_updated": {"type": "string", "format": "date-time"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["package_type", "created_at", "git_commit", "file_hash_sha256"],
            "properties": {
              "package_type": {"type": "string"},
              "created_at": {"type": "string", "format": "date-time"},
              "git_commit": {"type": "string"},
              "git_dirty": {"type": "boolean"},
              "r_version": {"type": "string"},
              "r_packages": {"type": "object"},
              "random_seed": {"type": "integer"},
              "input_hashes": {"type": "object"},
              "method_selected": {"type": ["string", "null"]},
              "method_shopping_log_ref": {"type": ["string", "null"]},
              "windows": {"type": ["object", "null"]},
              "file_path": {"type": "string"},
              "file_hash_sha256": {"type": "string"},
              "reproduction_command": {"type": "string"}
            }
          }
        }
      }
    },

    "status": {
      "type": "object",
      "description": "Work Task 진행 단계",
      "required": ["task_id", "current_phase", "updated_at"],
      "properties": {
        "task_id": {"type": "string"},
        "current_phase": {
          "type": "string",
          "enum": [
            "SPEC_DRAFT", "SPEC_APPROVED",
            "ALPHA_PENDING", "ALPHA_RUNNING", "ALPHA_DONE",
            "ALPHA_REVISE_REQUIRED",
            "RISK_PENDING", "RISK_RUNNING", "RISK_REVIEW", "RISK_DONE",
            "RISK_REVISE_REQUIRED",
            "OPTIMIZER_PENDING", "OPTIMIZER_RUNNING", "OPT_REVIEW", "OPTIMIZER_DONE",
            "FORGE_PENDING", "FORGE_RUNNING", "FORGE_DONE",
            "JUDGE_PENDING", "JUDGE_RUNNING", "JUDGE_PASSED", "JUDGE_FAILED",
            "GOVERNOR_PENDING", "GOVERNOR_ADMITTED", "GOVERNOR_REJECTED",
            "EXECUTION_PENDING", "EXECUTION_RUNNING", "EXECUTION_DONE",
            "MONITORING_SCHEDULED", "MONITORING_ACTIVE",
            "COMPLETED", "ABORTED"
          ]
        },
        "challenge_round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "R3 challenge loop 진행 round. 2회 초과 시 Q-Lead 개입."
        },
        "challenge_history": {
          "type": "array",
          "description": "R3 challenge loop 이력",
          "items": {
            "type": "object",
            "properties": {
              "round": {"type": "integer"},
              "from_agent": {"type": "string", "enum": ["risk", "optimizer"]},
              "to_agent": {"type": "string", "enum": ["alpha", "risk"]},
              "timestamp": {"type": "string", "format": "date-time"},
              "challenge_reason": {"type": "string"},
              "resolution": {"type": ["string", "null"]}
            }
          }
        },
        "updated_at": {"type": "string", "format": "date-time"},
        "blocker": {"type": "string"}
      }
    }
  },

  "oneOf": [
    {"$ref": "#/definitions/work_task_request"},
    {"$ref": "#/definitions/alpha_package"},
    {"$ref": "#/definitions/risk_package"},
    {"$ref": "#/definitions/optimization_package"},
    {"$ref": "#/definitions/execution_package"},
    {"$ref": "#/definitions/monitoring_report"},
    {"$ref": "#/definitions/governance_log"},
    {"$ref": "#/definitions/artifact_lineage"},
    {"$ref": "#/definitions/status"}
  ]
}
