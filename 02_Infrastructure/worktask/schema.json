{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qvest://worktask/schema/v1",
  "title": "QEPM Work Task Schema v1",
  "description": "1 Work Task = QEPM Full Pipeline 1회 = 1 리서치 사이클. Alpha → Risk → Optimizer 3-agent 순차 실행 후 Forge 통합 → Judge 검증 → Governor admission. (2026-07-25: alpha_package에 AST v1.1 3층 확장 — spec_version='ast_v1.1' conditional, SOT 02_Infrastructure/docs/qvest_ast_v1_1_sot.md §1·§2)",

  "definitions": {
    "work_task_request": {
      "type": "object",
      "required": [
        "task_id", "wt_type", "as_of_date", "forecast_horizon", "rebalance_frequency",
        "universe_definition", "benchmark_definition",
        "data_lag_rules", "cost_model_version",
        "hard_constraints"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^WT-[DPSH][0-9]{8}_[0-9]{3}$", "description": "WT-D = Discovery, WT-P = Deployment, WT-S = Sizing-only, WT-H = Hyperparameter-sweep (v1.2)"},
        "wt_type": {
          "type": "string",
          "enum": ["discovery", "deployment", "sizing_only", "hyperparameter_sweep"],
          "description": "v1.2 Charter §10: discovery=신규 alpha 발굴 / deployment=검증 alpha 편성 / sizing_only=parent inheritance audit + sizing rationale (alpha 0건 정상) / hyperparameter_sweep=parent alpha 동일 + grid sweep만. sizing_only/hyperparameter_sweep은 alpha_discovery_certificate 미발급 → PG1 admission 자격 없음."
        },
        "pg1_eligibility": {
          "type": "string",
          "enum": ["certificate_required", "eligible", "deployment_track"],
          "description": "v1.2 Charter §10: certificate_required = alpha_discovery_certificate 발급 필요 (sizing_only/hyperparameter_sweep), eligible = certificate 발급 받음, deployment_track = 검증된 alpha 직접 편성"
        },
        "discovery_of": {
          "type": ["string", "null"],
          "description": "Deployment WT만: 어떤 Discovery WT의 결과를 채택하는지 back-ref (예: WT-D20260423_001)"
        },
        "alpha_discovery_certificate": {
          "type": "object",
          "description": "v1.2 Charter §10: alpha_discovery_certifier.sh 발급. 미발급이면 PG1 admission 자격 박탈.",
          "properties": {
            "issued": {"type": "boolean"},
            "inheritance_cor_actual": {"type": "number", "minimum": 0, "maximum": 1.001},
            "inheritance_cor_max": {"type": "number", "default": 0.95},
            "mechanism_cited": {"type": "string", "minLength": 50},
            "factor_specs_new_count": {"type": "integer", "minimum": 0},
            "harvey_t_specs_pass_count": {"type": "integer", "minimum": 0},
            "issued_at": {"type": "string", "format": "date-time"},
            "non_issuance_reason": {"type": ["string", "null"], "description": "미발급 사유 (cor>=0.95 / mechanism<50chars / factor_specs=0 / harvey_t pass<3)"}
          }
        },
        "graduation_criteria": {
          "type": "object",
          "description": "Discovery → Deployment 전환 조건. wt_type=discovery 의무.",
          "properties": {
            "min_rank_ic": {"type": "number", "minimum": 0},
            "min_icir": {"type": "number", "minimum": 0},
            "min_subperiod_stability": {"type": "number", "minimum": 0, "maximum": 1},
            "max_drawdown_days": {"type": "integer"}
          }
        },
        "theme": {"type": "string", "maxLength": 200, "description": "주제 레벨 (예: 'Defense family 강화'). Alpha Agent가 Step 0에서 가설 자동 발굴 모드. hypothesis_title 있으면 무시."},
        "hypothesis_title": {"type": ["string", "null"], "maxLength": 200, "description": "구체 가설. null이면 Alpha Agent Step 0 Hypothesis Discovery 활성화."},
        "hypothesis_description": {"type": "string"},
        "hypothesis_source": {"type": "string", "enum": ["user_defined", "alpha_agent_discovered"], "description": "user_defined = 사용자 지정 / alpha_agent_discovered = Step 0 자동 발굴"},
        "as_of_date": {"type": "string", "format": "date"},
        "forecast_horizon": {"type": "string", "enum": ["1M", "3M", "6M", "12M"]},
        "rebalance_frequency": {"type": "string", "enum": ["weekly", "monthly", "quarterly"]},
        "evaluation_windows": {
          "type": "object",
          "description": "★v10 (2026-08-29 도훈): lockbox 제도 폐지 — 전 에이전트 가용 데이터 전기간 사용. lockbox_window 는 역사 산출물 파싱 호환으로 optional 존치(신규 발급 금지). IS/OOS anchored 분할(essence oos_retention)은 lockbox 가 아니라 측정 규율 — 별개.",
          "required": ["train_window", "validation_window"],
          "properties": {
            "train_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}}},
            "validation_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}}},
            "lockbox_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}, "sealed": {"type":"boolean"}}},
            "paper_trade_window": {"type": "object", "properties": {"start": {"type":"string","format":"date"}, "end": {"type":"string","format":"date"}}}
          }
        },
        "method_shopping_log_ref": {"type": "string", "description": "path to method_shopping_log.json"},
        "universe_definition": {
          "type": "object",
          "required": ["label", "liquidity_min_won_20d_avg", "max_names_total"],
          "properties": {
            "label": {"type": "string", "enum": ["KOSPI200", "KOSDAQ150", "KOSPI200_KOSDAQ150_intersection", "KR_top500", "KR_top342", "KR_TOP500_FREEFLOAT", "KR_KOSPI300_KOSDAQ150", "KR_TOP500_LIQ1E8", "KR_ALL_LIQ2E8"]},
            "liquidity_min_won_20d_avg": {"type": "number", "minimum": 100000000},
            "max_names_total": {"type": "integer", "maximum": 2500}
          }
        },
        "benchmark_definition": {"type": "string"},
        "data_lag_rules": {
          "type": "object",
          "required": ["fundamental", "price", "investor_flow", "macro"],
          "properties": {
            "fundamental": {"type": "string", "pattern": ".*(45d|monthly|quarterly).*"},
            "price": {"type": "string"},
            "investor_flow": {"type": "string"},
            "macro": {"type": "string"}
          }
        },
        "cost_model_version": {"type": "string", "pattern": "^v[0-9.]+_.+_[0-9]+bps$"},
        "current_portfolio": {"type": "string", "description": "현 PG2 reference"},
        "hard_constraints": {
          "type": "object",
          "required": ["max_names", "weight_bounds", "liquidity_min_won_20d_avg"],
          "properties": {
            "max_names": {"type": "integer", "maximum": 25, "description": "Hard cap 25 (user rule, 도훈 mandate 2026-05-29 20→25)"},
            "weight_bounds": {
              "type": "array",
              "minItems": 2, "maxItems": 2,
              "items": {"type": "number"},
              "description": "[min, max]. Long-only면 [0, 0.20]"
            },
            "sector_active_weight_cap": {"type": "number", "minimum": 0, "maximum": 0.30},
            "liquidity_min_won_20d_avg": {"type": "number", "minimum": 200000000}
          }
        },
        "soft_penalties": {
          "type": "object",
          "properties": {
            "turnover_cap_annual": {"type": "number", "minimum": 0, "maximum": 12},
            "beta_target": {"type": "number"},
            "style_exposure_cap": {"type": "number"}
          }
        },
        "capacity_limits": {
          "type": "object",
          "properties": {
            "adv_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
            "capacity_max_aum_won": {"type": "number"}
          }
        }
      }
    },

    "ast_node": {
      "description": "AST v1.1 팩터 식 노드 (SOT: 02_Infrastructure/docs/qvest_ast_v1_1_sot.md §2). leaf 노드 또는 op 노드 재귀 구조. LEAD/FUTURE_* 연산자는 문법적 부재 (표현 불가 = 실수 불가 — Cycle 50 double-negation 유형의 문법적 제거). leaf와 op 동시 보유 노드는 oneOf 위반으로 invalid.",
      "oneOf": [
        {
          "type": "object",
          "required": ["leaf"],
          "properties": {
            "leaf": {
              "type": "string",
              "minLength": 1,
              "description": "리프 식별자: ast_field_map_v0.json 등재 리프 그룹(group_id 또는 group_id:field) / factor_registry.json factor_id / escape 리프 4종(MODEL_SCORE|STORED_SCORE|LLM_SCORE|SPECIAL_OP). escape 리프는 escape_contract 의무."
            },
            "escape_contract": {"$ref": "#/definitions/escape_contract"}
          },
          "allOf": [
            {
              "if": {"properties": {"leaf": {"enum": ["MODEL_SCORE", "STORED_SCORE", "LLM_SCORE", "SPECIAL_OP"]}}},
              "then": {"required": ["escape_contract"]}
            }
          ]
        },
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "CS_RANK", "CS_ZSCORE", "CS_WINSORIZE", "CS_NEUTRALIZE", "CS_DEMEAN",
                "TS_LAG", "TS_DELTA", "TS_MEAN", "TS_STD", "TS_RANK", "TS_MIN", "TS_MAX", "TS_SUM", "TS_CORR", "TS_BETA",
                "ADD", "SUB", "MUL", "DIV_GUARD", "LOG", "ABS", "SIGN", "SQRT",
                "CLIP", "IF_ELSE", "WHERE",
                "AS_OF", "VINTAGE"
              ],
              "description": "연산자 라이브러리 𝒪 초기 최소집합 (SOT §2 — 원안 v1.0 §2 그대로 채택). 조건(CLIP/IF_ELSE/WHERE)은 complexity 별도 카운트. 𝒪 확장은 06_Registry/ast_operator_backlog.json에 blocked_by_capability verdict 적립분만 근거 (선제 확장 금지). 𝒪 밖 연산자 = ast_spec_gate.sh ④ block."
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {"$ref": "#/definitions/ast_node"},
                  {"type": "number"},
                  {"type": "string"},
                  {"type": "boolean"}
                ]
              },
              "description": "피연산자: 하위 ast_node 또는 스칼라 파라미터(윈도우 길이·클립 경계 등). 윈도우/lag는 부호 없는 명시적 양수 (SOT §4-3)."
            }
          }
        }
      ]
    },

    "escape_contract": {
      "type": "object",
      "description": "escape 리프 4종 PIT 계약 (SOT §2 — AST 환원 불가 산출 수용, 헌장 자율성 보존). escape_type별 conditional required. 파생 패널을 FIELD로 위장 금지 (§4-1).",
      "required": ["escape_type"],
      "properties": {
        "escape_type": {"type": "string", "enum": ["MODEL_SCORE", "STORED_SCORE", "LLM_SCORE", "SPECIAL_OP"]},
        "train_window_end": {"type": "string", "format": "date", "description": "MODEL_SCORE: 학습창 종점 선언 — t_d − 1 이하 의무"},
        "training_leaf_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "MODEL_SCORE: 학습 데이터 리프 목록 (각 리프는 ast_field_map 검증 대상)"},
        "provenance": {
          "type": "object",
          "required": ["store_build_hash", "generator_code_path", "generated_at"],
          "properties": {
            "store_build_hash": {"type": "string"},
            "generator_code_path": {"type": "string"},
            "generated_at": {"type": "string"}
          },
          "description": "STORED_SCORE: provenance 3필드 (기반 store build_hash + 생성 코드 경로 + 생성 시각)"
        },
        "production_parity_verified": {"type": "boolean", "description": "STORED_SCORE: measurement-graduation §7b 기계화 — false면 incumbent base 소비 불가 (저장 패널 동월 look-ahead 실사고 2026-07-14)"},
        "doc_rcept_dt_max": {"type": "string", "description": "LLM_SCORE: 채점 대상 문서 rcept_dt 최댓값 — t_d 이하 의무"},
        "prompt_sha": {"type": "string", "description": "LLM_SCORE: 프롬프트 sha 동결"},
        "model_sha": {"type": "string", "description": "LLM_SCORE: 모델 sha 동결"},
        "op_code_path": {"type": "string", "description": "SPECIAL_OP: 연산 정의 코드 경로 (TE/Kalman 등)"},
        "walk_forward": {"type": "boolean", "description": "SPECIAL_OP: walk-forward 여부 선언"}
      },
      "allOf": [
        {"if": {"properties": {"escape_type": {"const": "MODEL_SCORE"}}}, "then": {"required": ["train_window_end", "training_leaf_refs"]}},
        {"if": {"properties": {"escape_type": {"const": "STORED_SCORE"}}}, "then": {"required": ["provenance", "production_parity_verified"]}},
        {"if": {"properties": {"escape_type": {"const": "LLM_SCORE"}}}, "then": {"required": ["doc_rcept_dt_max", "prompt_sha", "model_sha"]}},
        {"if": {"properties": {"escape_type": {"const": "SPECIAL_OP"}}}, "then": {"required": ["op_code_path", "walk_forward"]}}
      ]
    },

    "ast_hypothesis": {
      "type": "object",
      "required": ["statement", "mechanism", "falsification", "regime_scope"],
      "description": "AST v1.1 가설층 — 구조화 JSON (SOT §1). spec_version='ast_v1.1' 패키지에만 적용 (alpha_package allOf 조건부 참조). '시장이 비효율적' 류(주체·마찰 무명명)는 기계 반려 (ast_spec_gate.sh ①).",
      "properties": {
        "statement": {"type": "string", "minLength": 20, "description": "가설 1~3문장 서술"},
        "mechanism": {
          "type": "object",
          "required": ["agent", "friction", "path"],
          "properties": {
            "agent": {"type": "string", "minLength": 5, "description": "누가 — 오류/제약의 주체를 실명 특정 (예: '개인 순매수 군집', '연기금 리밸런싱 캘린더')"},
            "friction": {"type": "string", "minLength": 5, "description": "왜 차익거래로 안 지워지는가 — 마찰 특정 (예: 공매도 제약, 유동성 하한, 공시 지연)"},
            "path": {"type": "string", "minLength": 5, "description": "신호→수익 전달 경로 — 어느 시점·어떤 형태로 가격 반영되는지"}
          }
        },
        "falsification": {
          "type": "array",
          "minItems": 1,
          "description": "반증 조건 배열 — 성과 동어반복 금지. 각 원소는 field_dictionary(factor_registry 팩터명 ∪ 06_Registry/ast_field_map_v0.json group_id) 내 필드를 **지목**해야 한다. [ALB-005 수리 2026-08-02] 종전 정의는 {type:string}이었는데 ast_spec_gate.sh ①은 객체배열을 요구해 **두 계층을 동시에 만족하는 패키지가 존재하지 않았다**(스키마를 따르면 게이트 block, 게이트를 따르면 스키마 위반). 정본을 객체배열로 확정한다 — 자유 서술 문자열은 그럴듯해 보여도 누구도 확인할 수 없어 반증 조건 구실을 못 한다(실사례: '수출비중 하위 그룹에서 신호가 소멸' → field_dictionary 밖 반려).",
          "items": {
            "type": "object",
            "description": "field / fields / field_ref / leaf / group_id / factor 중 하나 이상으로 필드를 지목 (게이트 fals_fields 수용 키셋과 동일)",
            "anyOf": [
              {"required": ["field"]}, {"required": ["fields"]}, {"required": ["field_ref"]},
              {"required": ["leaf"]}, {"required": ["group_id"]}, {"required": ["factor"]}
            ],
            "properties": {
              "field": {"type": "string", "description": "factor_registry 팩터명 또는 ast_field_map group_id (예: V02_EP)"},
              "fields": {"type": "array", "items": {"type": "string"}},
              "field_ref": {"type": "string"},
              "leaf": {"type": "string"},
              "group_id": {"type": "string"},
              "factor": {"type": "string"},
              "expectation": {"type": "string", "description": "그 필드에서 무엇이 관측되어야 가설이 살아 있는가 — 성과 지표 재진술 금지"}
            }
          }
        },
        "regime_scope": {
          "type": "object",
          "required": ["holds_in", "weakens_or_reverses_in"],
          "properties": {
            "holds_in": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "성립 국면"},
            "weakens_or_reverses_in": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "약화/반전 국면 — 빈 배열 금지 (보편타당 주장 반려, ast_spec_gate.sh ③)"},
            "boundary_rationale": {"type": "string", "description": "경계가 메커니즘에서 도출되는 근거 (judge Claude 축 4 advisory 대상 — SOT §7)"}
          }
        }
      }
    },

    "label_eligibility_evidence": {
      "type": "object",
      "description": "FQ-119 라벨 자격 관문(02_Infrastructure/contracts/label_eligibility_gate.R) 산출 증거. 통과 조건 = recall > base_rate ∧ fisher 단측 p < 0.05 (문턱 sweep 금지 고정). ★UNMEASURABLE_*/UNAVAILABLE_* 은 합격이 아니다 — '재지 못했다'를 '통과했다'로 접는 것을 막기 위해 verdict enum 에 별도 상태로 둔다. 근거 실측(2026-08-03): 무판별 라벨을 소비면에 강행하면 발화 월수에 비례해 유해(WT-019 paired -3.77) — 판별력 없는 라벨은 중립이 아니라 손실이다.",
      "required": ["verdict", "recall", "base_rate", "fisher_p", "n_months", "event_definition", "label_definition", "contract"],
      "properties": {
        "eligible": {"type": ["boolean", "null"], "description": "true 만 통과. null = 판정 불가(합격 아님)"},
        "verdict": {
          "type": "string",
          "enum": ["ELIGIBLE", "INELIGIBLE_NO_DISCRIMINATION", "UNMEASURABLE_NO_DATA", "UNMEASURABLE_DEGENERATE", "UNAVAILABLE_PANEL", "GATE_ERROR"]
        },
        "recall": {"type": ["number", "null"]},
        "base_rate": {"type": ["number", "null"]},
        "lift": {"type": ["number", "null"]},
        "fisher_p": {"type": ["number", "null"]},
        "n_months": {"type": "integer", "minimum": 0},
        "n_label_on": {"type": ["integer", "null"]},
        "n_event": {"type": ["integer", "null"]},
        "event_definition": {"type": "string", "minLength": 5, "description": "★자격은 (라벨, 사건정의) 쌍에 붙는다 — 같은 라벨이 사건 정의에 따라 뒤집힌다(2026-08-08 실측: 월수익<0% INELIGIBLE / <-5% lift 1.97x / <-10% lift 3.19x). 정의를 적지 않은 판정은 인용 불가."},
        "label_definition": {"type": "string", "minLength": 5},
        "label_basis": {"type": "string", "description": "라벨 구성 규약. 소비 지점이 실제로 쓰는 구성과 같아야 한다(두 구성 간 라벨 일치율 0.804 실측 — 다른 구성으로 재면 대용품 검사)."},
        "label_source": {"type": "string"},
        "asof": {"type": "string"},
        "contract": {"type": "string", "description": "판정을 낸 계약 파일 경로 — 손계산 판정 차단"}
      }
    },

    "label_consumption": {
      "type": "object",
      "description": "FQ-119: 이 라운드가 국면/상태 **라벨을 소비**하는가의 선언. 선언 자체는 선택(미선언 패키지는 기존대로 유효 — 진행 중 라운드 emit 무영향)이지만, consumes_regime_label=true 로 선언하면 자격 증거 제출이 **조건부 required** 가 된다. ⚠선언을 생략해 관문을 피하는 경로는 스키마로는 막히지 않는다 — 그 축은 worktask_artifact_validator.sh 가 패키지 본문에서 라벨 소비 흔적을 탐지해 warn 으로 보완한다(미선언 소비 탐지).",
      "required": ["consumes_regime_label"],
      "properties": {
