              "enum": ["NEGLIGIBLE", "MINOR_DRIFT", "SIGNIFICANT_DRAG", "FABRICATION_SUSPECTED"],
              "description": "auto rule: |·|<0.1 NEGLIGIBLE / 0.1-0.3 MINOR_DRIFT / 0.3-0.6 SIGNIFICANT_DRAG / ≥0.6 FABRICATION_SUSPECTED"
            }
          }
        },
        "backtest_summary": {
          "type": "object",
          "properties": {
            "full_period": {"type": "object"},
            "pre_lockbox": {"type": "object"},
            "lockbox": {"type": "object"}
          }
        },
        "factor_regression_5_specs": {
          "type": "object",
          "description": "CAPM / FF3 / FF5 / Carhart4 / FF5+Mom Harvey NW-HAC t-stats"
        },
        "hard_caps": {
          "type": "object",
          "properties": {
            "mdd_pass": {"type": "boolean"},
            "to_pass": {"type": "boolean"},
            "cvar_d_pass": {"type": "boolean"},
            "all_pass": {"type": "boolean"}
          }
        },
        "hash_audit_pass": {"type": "boolean"}
      }
    },

    "hurdle_result": {
      "type": "object",
      "description": "Optimizer/Forge intermediate result. Charter §9 — production_grade=true는 forge_realized_share_based만.",
      "required": ["task_id", "method", "method_basis_label", "production_grade"],
      "properties": {
        "task_id": {"type": "string"},
        "method": {
          "type": "string",
          "description": "Charter §9: 'ProductionSchedule[N]m' 표현 금지 (fabrication label)"
        },
        "method_basis_label": {
          "type": "string",
          "enum": [
            "optimizer_walk_forward_simulation",
            "factor_engine_continuous",
            "forge_realized_share_based"
          ]
        },
        "production_grade": {
          "type": "boolean",
          "description": "true는 forge_realized_share_based만. factor_engine_continuous = false."
        }
      }
    },

    "execution_package": {
      "type": "object",
      "description": "R8 Execution Agent 산출물. Deployment WT의 target_weights → 주문 분할 + impact 추정.",
      "required": ["task_id", "rebalance_date", "trade_list", "schedule"],
      "properties": {
        "task_id": {"type": "string"},
        "rebalance_date": {"type": "string", "format": "date"},
        "trade_list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ticker", "side", "shares"],
            "properties": {
              "ticker": {"type": "string"},
              "side": {"type": "string", "enum": ["buy", "sell"]},
              "shares": {"type": "integer", "minimum": 0},
              "target_weight": {"type": "number", "minimum": 0, "maximum": 0.20},
              "current_weight": {"type": "number"}
            }
          }
        },
        "schedule": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "enum": ["single_shot", "TWAP", "VWAP", "POV"]},
            "duration_hours": {"type": "number"},
            "participation_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "start_time": {"type": "string"},
            "end_time": {"type": "string"}
          }
        },
        "impact_estimate_bps": {
          "type": "object",
          "properties": {
            "avg": {"type": "number"},
            "worst_ticker": {"type": "string"},
            "worst_bps": {"type": "number"}
          }
        },
        "expected_slippage_bps": {"type": "number"},
        "capacity_warnings": {"type": "array", "items": {"type": "string"}},
        "method": {"type": "string"}
      }
    },

    "monitoring_report": {
      "type": "object",
      "description": "R9 Monitoring Agent 산출물. admitted WT realized vs predicted drift.",
      "required": ["monitoring_month", "admitted_wts_monitored", "per_wt_results"],
      "properties": {
        "monitoring_month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "admitted_wts_monitored": {"type": "array", "items": {"type": "string"}},
        "per_wt_results": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "alpha_predicted": {"type": "number"},
              "alpha_realized": {"type": "number"},
              "alpha_ratio": {"type": "number"},
              "te_predicted": {"type": "number"},
              "te_realized": {"type": "number"},
              "te_ratio": {"type": "number"},
              "crowding_now": {"type": "number"},
              "crowding_3m_ago": {"type": "number"},
              "crowding_drift": {"type": "number"},
              "ic_3m": {"type": "number"},
              "ic_12m": {"type": "number"},
              "ic_decay_ratio": {"type": "number"},
              "regime_cached": {"type": "string"},
              "regime_current": {"type": "string"},
              "alerts": {"type": "array", "items": {"type": "string"}},
              "action_requested": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "book_level": {
          "type": "object",
          "properties": {
            "aggregate_alpha_ratio": {"type": "number"},
            "aggregate_te_ratio": {"type": "number"},
            "highest_alert_count_wt": {"type": "string"}
          }
        },
        "telegram_sent": {"type": "boolean"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },

    "governance_log": {
      "type": "object",
      "description": "Work Task 내 결정 이력",
      "properties": {
        "task_id": {"type": "string"},
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "agent", "action", "summary"],
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "agent": {"type": "string", "enum": ["alpha", "risk", "optimizer", "forge", "judge", "governor", "execution", "monitoring", "q-lead"]},
              "action": {"type": "string"},
              "summary": {"type": "string"},
              "challenge_notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },

    "artifact_lineage": {
      "type": "object",
      "description": "R11 Artifact lineage + reproducibility. Each package write appends an entry.",
      "required": ["task_id", "entries"],
      "properties": {
        "task_id": {"type": "string"},
        "schema_version": {"type": "string"},
        "last_updated": {"type": "string", "format": "date-time"},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["package_type", "created_at", "git_commit", "file_hash_sha256"],
            "properties": {
              "package_type": {"type": "string"},
              "created_at": {"type": "string", "format": "date-time"},
              "git_commit": {"type": "string"},
              "git_dirty": {"type": ["boolean", "null"],
                            "description": "null = 미측정. FALSE 를 미측정 자리에 쓰지 말 것 — clean tree 와 구분 불가해진다 (2026-08-02)"},
              "git_state_error": {"type": ["string", "null"],
                                  "description": "git 상태 수집 실패 사유. 비-null 이면 git_commit/git_dirty 는 신뢰 불가"},
              "r_version": {"type": "string"},
              "r_packages": {"type": "object"},
              "random_seed": {"type": "integer"},
              "input_hashes": {"type": "object"},
              "method_selected": {"type": ["string", "null"]},
              "method_shopping_log_ref": {"type": ["string", "null"]},
              "windows": {"type": ["object", "null"]},
              "file_path": {"type": "string"},
              "file_hash_sha256": {"type": "string"},
              "reproduction_command": {"type": "string"}
            }
          }
        }
      }
    },

    "status": {
      "type": "object",
      "description": "Work Task 진행 단계",
      "required": ["task_id", "current_phase", "updated_at"],
      "properties": {
        "task_id": {"type": "string"},
        "current_phase": {
          "type": "string",
          "enum": [
            "SPEC_DRAFT", "SPEC_APPROVED",
            "ALPHA_PENDING", "ALPHA_RUNNING", "ALPHA_DONE",
            "ALPHA_REVISE_REQUIRED",
            "RISK_PENDING", "RISK_RUNNING", "RISK_REVIEW", "RISK_DONE",
            "RISK_REVISE_REQUIRED",
            "OPTIMIZER_PENDING", "OPTIMIZER_RUNNING", "OPT_REVIEW", "OPTIMIZER_DONE",
            "FORGE_PENDING", "FORGE_RUNNING", "FORGE_DONE",
            "JUDGE_PENDING", "JUDGE_RUNNING", "JUDGE_PASSED", "JUDGE_FAILED",
            "GOVERNOR_PENDING", "GOVERNOR_ADMITTED", "GOVERNOR_REJECTED",
            "EXECUTION_PENDING", "EXECUTION_RUNNING", "EXECUTION_DONE",
            "MONITORING_SCHEDULED", "MONITORING_ACTIVE",
            "COMPLETED", "ABORTED"
          ]
        },
        "challenge_round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "R3 challenge loop 진행 round. 2회 초과 시 Q-Lead 개입."
        },
        "challenge_history": {
          "type": "array",
          "description": "R3 challenge loop 이력",
          "items": {
            "type": "object",
            "properties": {
              "round": {"type": "integer"},
              "from_agent": {"type": "string", "enum": ["risk", "optimizer"]},
              "to_agent": {"type": "string", "enum": ["alpha", "risk"]},
              "timestamp": {"type": "string", "format": "date-time"},
              "challenge_reason": {"type": "string"},
              "resolution": {"type": ["string", "null"]}
            }
          }
        },
        "updated_at": {"type": "string", "format": "date-time"},
        "blocker": {"type": "string"}
      }
    }
  },

  "oneOf": [
    {"$ref": "#/definitions/work_task_request"},
    {"$ref": "#/definitions/alpha_package"},
    {"$ref": "#/definitions/risk_package"},
    {"$ref": "#/definitions/optimization_package"},
    {"$ref": "#/definitions/execution_package"},
    {"$ref": "#/definitions/monitoring_report"},
    {"$ref": "#/definitions/governance_log"},
    {"$ref": "#/definitions/artifact_lineage"},
    {"$ref": "#/definitions/status"}
  ]
}
