        },
        "blocker": {"type": "string", "minLength": 10, "description": "blocked_by_capability 시: 표현 불가한 필요 연산/데이터 서술"},
        "unblock_requirement": {"type": "string", "minLength": 10, "description": "blocked_by_capability 시: 해소 요건 (신규 연산자 / 데이터 원천 / 접근자) — 06_Registry/ast_operator_backlog.json 적립 근거"},
        "void_rationale": {"type": "string", "minLength": 10, "description": "economic_void 시: 메커니즘 부재 판단 근거 — §6 confirmed_voids + hypothesis_index 교차 등재용"},
