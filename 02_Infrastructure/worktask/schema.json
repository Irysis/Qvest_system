              "role": {"type": "string", "minLength": 3, "description": "결합 내 역할 (예: core_signal / conditioning / interaction / diagnostic)"},
              "restatement_exposure": {"type": "integer", "minimum": 0, "description": "restatement_prone 리프 개수 (registry restatement_prone 기준 — verify() WARN_RESTATEMENT 소스, Phase 2 사이드카 ast_features.restatement_exposure 집계)"}
            }
