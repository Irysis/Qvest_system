{
  "$schema": "qvest://worktask/schema/v1",
  "description": "Work Task hard constraints 기본값 (사용자 지시 강제). 모든 신규 WT에 자동 주입.",
  "version": "v1.0",
  "effective_from": "2026-04-23",
  "owner": "사용자 (Dohoon Kim)",

  "hard_constraints": {
    "max_names": 20,
    "max_names_rationale": "사용자 명시 — 최종 포트폴리오 20종 hard. 슬리브당이 아님.",

    "weight_bounds": [0.0, 0.10],
    "weight_bounds_rationale": "Long-only, 종목별 10% 상한 (concentration 방지)",

    "long_only": true,
    "long_only_rationale": "KR 증권사 실무 long-only only",

    "sum_weights_absolute": 1.0,
    "sum_weights_active": 0.0,
    "sum_weights_rationale": "benchmark-relative active management. absolute는 1, active는 0.",

    "liquidity_min_won_20d_avg": 200000000,
    "liquidity_rationale": "20일 평균 거래대금 >= 2억원 (실투 실행 가능성)",

    "universe_allowed": ["KOSPI200", "KOSDAQ150", "KOSPI200_KOSDAQ150_intersection", "KR_top500"],
    "universe_rationale": "KR 국내 주식만. 글로벌 크로스마켓 금지.",

    "sector_active_weight_cap": 0.10,
    "sector_active_weight_cap_rationale": "단일 섹터 활성 비중 10% 이하 (분산 유지)"
  },

  "soft_penalties": {
    "turnover_cap_annual": 3.0,
    "turnover_cap_rationale": "연 300% 초과 시 penalty. 600% 이상은 hard fail.",

    "beta_target": 1.0,
    "beta_target_rationale": "시장 베타 1.0 근처 (시장중립 아님, 시장 노출 유지)",

    "style_exposure_cap": 2.0,
    "style_exposure_cap_rationale": "스타일 z-score 2.0 이내"
  },

  "cost_model": {
    "cost_model_version": "v2.3_kr_retail_15bps",
    "transaction_cost_bps_one_way": 15,
    "market_impact_model": "linear_sqrt_ADV",
    "capacity_adv_multiplier": 0.10,
    "cost_rationale": "KR 리테일 증권사 평균 수수료 + 시장 충격 근사"
  },

  "data_lag_rules_default": {
    "fundamental": "quarterly 45d (재무제표 발표 지연)",
    "fundamental_annual": "annual May (연간 재무제표 5월 리밸런싱)",
    "price": "t-1 close",
    "investor_flow": "t-1 settlement (QuantiWise)",
    "macro": "t-1 FRED (외부 매크로 lag)",
    "ic_history": "Usable_Date <= sig_date (Factor DB 강제)"
  },

  "pit_enforcement": {
    "c1_rolling_only": true,
    "c2_t1_lag": true,
    "c3_no_period_circular": true,
    "c4_fs_lag": true,
    "c5_overlay_t1": true,
    "c10_liquidity_shift_1L": true,
    "c13_z_score_aligned_only": true,
    "c14_usable_date_le_sig_date": true,
    "c15_load_month_factors_only": true,
    "c15_carve_out_ml_daily": "L-164 v1.1 ML 전략 + daily parquet 예외",
    "pit_validation_skill": "pit-validation",
    "pit_enforcement_r": "02_Infrastructure/validation/pit_enforcement.R",
    "lookahead_detector_r": "02_Infrastructure/validation/lookahead_detector.R"
  },

  "agent_role_boundaries": {
    "alpha_agent_forbidden": [
      "covariance matrix 계산",
      "weight 결정 로직",
      "사전 제약 최적화",
      "risk model 흉내 (중립화는 허용, risk 판단 대체 금지)"
    ],
    "risk_agent_forbidden": [
      "alpha 시그널 추가",
      "alpha_vector 수정",
      "weight 제안",
      "좋은 종목/나쁜 종목 판단"
    ],
    "optimizer_agent_forbidden": [
      "alpha 재해석",
      "risk model 재정의",
      "연구 가설 수정",
      "조용한 제약 완화 (infeasibility_report 필수)"
    ]
  },

  "work_task_sequence": {
    "enforced_order": ["alpha", "risk", "optimizer", "forge", "judge", "governor"],
    "parallel_allowed_across_tasks": true,
    "parallel_forbidden_within_task": true,
    "rationale": "1 WT 내부는 순차, WT 간은 병렬 (Q-Lead orchestration)"
  }
}
