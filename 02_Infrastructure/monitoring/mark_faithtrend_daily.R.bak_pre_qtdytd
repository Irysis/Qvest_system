## FaithTrend book — 데일리 mark-to-market (모닝브리핑용). 현 라이브 홀딩 × RAWDATA 일별.
## 월간 리밸(forward_weights_R05_FAITH.R)이 최신 배포홀딩 산출 → 이 스크립트가 매일 평가.
suppressPackageStartupMessages({library(data.table); library(arrow); library(jsonlite)})
ROOT <- Sys.getenv("QM_ROOT", Sys.getenv("CLAUDE_PROJECT_DIR","C:/Users/99922/OneDrive/Quant_Module_Moltbot"))
BOOK_ID <- "STR_1715_FaithTrend_on_M4_R05_overlay_PG2"
HU <- file.path(ROOT,"05_Production/2.Factor_Model/2-2.STR_1715_FaithTrend_on_M4_R05_overlay_PG2/02_holdings_universe")
LT <- file.path(ROOT,"06_Registry/live_track",BOOK_ID); dir.create(LT,showWarnings=FALSE,recursive=TRUE)
send_tg <- Sys.getenv("FAITH_DAILY_TG","1")=="1"

## 1) 최신 faith 배포 홀딩 (리밸 date = 파일명)
wf <- list.files(HU, pattern="_FAITH_weights_cap_0p20\\.csv$", full.names=TRUE)
if(!length(wf)){cat("[faith-daily] 배포 홀딩 없음 — 월간 리밸(forward_weights_R05_FAITH.R) 선행 필요.\n"); quit(save="no")}
wf <- wf[which.max(file.mtime(wf))]; reb_date <- as.Date(gsub(".*/(\\d{8})_.*","\\1",wf),format="%Y%m%d")
W <- fread(wf); stk <- W[Ticker!="CASH" & Weight>0]; invested <- sum(stk$Weight); cash <- 1-invested

## 2) RAWDATA 일별 (리밸 이후) — 신선 캐시
raw <- as.data.table(read_parquet(file.path(ROOT,".cache/RAWDATA.parquet"),col_select=c("Date","Ticker","Ret")))
raw[, Date:=as.Date(Date)]; rd <- raw[Ticker %in% stk$Ticker & Date>reb_date]
if(!nrow(rd)){cat(sprintf("[faith-daily] 리밸(%s) 이후 신규 거래일 없음 — 데이터 대기.\n",reb_date)); quit(save="no")}
days <- sort(unique(rd$Date)); last_d <- days[length(days)]
## 종목 누적/전일 수익 → 북 (매수후보유, CASH=0)
cum <- rd[, .(cum=prod(1+Ret,na.rm=TRUE)-1), by=Ticker]
lastret <- rd[Date==last_d, .(Ticker,dret=Ret)]
m <- merge(stk[,.(Ticker,Weight)], cum, by="Ticker", all.x=TRUE); m <- merge(m, lastret, by="Ticker", all.x=TRUE)
mtd <- sum(m$Weight*m$cum, na.rm=TRUE); dayret <- sum(m$Weight*m$dret, na.rm=TRUE)
## KOSPI 비교
bmk <- as.data.table(read_parquet(file.path(ROOT,".cache/benchmark.parquet"))); bcol<-intersect(c("BM_Ret","Ret"),names(bmk))[1]
bmk[, Date:=as.Date(Date)]; bmd <- bmk[Date>reb_date & Date<=last_d & is.finite(get(bcol))]
bm_mtd <- prod(1+bmd[[bcol]],na.rm=TRUE)-1; bm_day <- bmk[Date==last_d, get(bcol)][1]

cat(sprintf("[faith-daily] %s | 리밸 %s 이후 %d거래일\n", last_d, reb_date, length(days)))
cat(sprintf("  북 MTD %+.2f%% (전일 %+.2f%%) | 노출 %.0f%% 현금 %.0f%% | KOSPI MTD %+.2f%%\n",
            mtd*100, dayret*100, invested*100, cash*100, bm_mtd*100))

## 3) daily_nav.csv append
dn_path <- file.path(LT,"daily_nav.csv")
row <- data.table(date=as.character(last_d), reb_date=as.character(reb_date), book_mtd=mtd, book_day=dayret,
                  invested=invested, cash=cash, kospi_mtd=bm_mtd, kospi_day=bm_day, n_days=length(days))
if(file.exists(dn_path)){dn<-fread(dn_path); dn<-dn[date!=as.character(last_d)]; dn<-rbind(dn,row,fill=TRUE)} else dn<-row
setorder(dn,date); fwrite(dn,dn_path)

## 4) 모닝브리핑 Telegram (데일리 북 성과)
if(send_tg) tryCatch({
  source(file.path(ROOT,"02_Infrastructure/telegram/telegram_notify.R"))
  top <- stk[order(-Weight)][seq_len(min(5,nrow(stk)))]
  tg_agent_brief(agent="Monitoring", title="FaithTrend book 데일리 성과 (모닝브리핑)",
    sections=list(
      list(type="summary", emoji="📈", body=sprintf("현 라이브 북 평가 (리밸 %s 이후 %d거래일). 노출 %.0f%%·현금 %.0f%% (강세방어).", reb_date, length(days), invested*100, cash*100)),
      list(type="kv", emoji="📊", heading="일별 성과 (북 / KOSPI)",
        kv=list("월초대비(MTD)"=sprintf("%+.2f%% / %+.2f%%", mtd*100, bm_mtd*100),
                "전일"=sprintf("%+.2f%% / %+.2f%%", dayret*100, ifelse(is.na(bm_day),0,bm_day)*100),
                "노출 / 현금"=sprintf("%.0f%% / %.0f%%", invested*100, cash*100),
                "기준일"=as.character(last_d))),
      list(type="bullet", emoji="📌", heading="상위 보유",
        items=sprintf("%s %.1f%% (누적 %+.1f%%)", top$Name, top$Weight*100, merge(top[,.(Ticker)],cum,by="Ticker",all.x=TRUE)$cum*100))),
    footer="📚 월간 리밸=forward_weights_R05_FAITH · 데일리 mark-to-market")
}, error=function(e) cat("[TG skip]",conditionMessage(e),"\n"))
cat("=== faith-daily done ===\n")
