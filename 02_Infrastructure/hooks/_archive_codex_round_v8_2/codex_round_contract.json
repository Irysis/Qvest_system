{
  "$schema": "qvest-v6.4/codex_round_contract.json",
  "version": "1.0",
  "issued_at": "2026-05-01T15:30:00+0900",
  "description": "v6.0 Codex Critic Round 5단계 흐름 single source. codex_round_auto_trigger.sh + codex_round_pre_enforcer.sh + qvest_hook_router.py 공통 import.",

  "applicable_roles": [
    "alpha-research",
    "risk-research",
    "optimizer-research",
    "forge",
    "judge",
    "governor"
  ],

  "five_stage_flow": [
    {
      "stage": 1,
      "name": "draft_write",
      "actor": "agent",
      "tool": "Write|Edit",
      "output_path_pattern": "qepm/mailbox/worktask/{WT_ID}/{role}_package_draft.json",
      "draft_path_examples": [
        "alpha_package_draft.json",
        "risk_package_draft.json",
        "optimization_package_draft.json",
        "forge_package_draft.json",
        "judge_verdict_draft.json",
        "governor_admission_draft.json"
      ],
      "required": true
    },
    {
      "stage": 2,
      "name": "codex_auto_spawn",
      "actor": "system",
      "trigger_hook": "codex_round_auto_trigger.sh",
      "trigger_event": "PostToolUse[Write|Edit]",
      "matcher_regex": "/(alpha|risk|optimization|forge)_package_draft\\.json$|/(judge_verdict|governor_admission)_draft\\.json$",
      "executes": "bash 02_Infrastructure/tools/debate_helpers/run_codex_qepm_critic.sh --role={role} --task_id={WT_ID} --package={draft_path} --output={response_path}",
      "duration_estimate_seconds": [540, 900],
      "background": true,
      "timeout_seconds": 1200
    },
    {
      "stage": 3,
      "name": "codex_response_review",
      "actor": "agent",
      "input_path_pattern": "qepm/mailbox/worktask/{WT_ID}/codex_critic_response_{role}.json",
      "review_fields": [
        "verdict.stance ∈ {APPROVE | APPROVE_CONDITIONAL | REVISE | REJECT}",
        "verdict.weakest_assumption (string)",
        "critical_concerns[].id / severity / description / ax_cite",
        "verdict.veto_flag (boolean, default false)"
      ]
    },
    {
      "stage": 4,
      "name": "challenge_note_record",
      "actor": "agent",
      "output_path": "qepm/mailbox/worktask/{WT_ID}/challenge_note.md",
      "alternate_role_specific_paths": [
        "risk_challenge_note.md",
        "optimizer_challenge_note.md",
        "alpha_challenge_note.md (rare)"
      ],
      "alternate_resolution": "Phase 6 결정 — role-specific → canonical 집계 vs role-specific retain",
      "required_classification_per_concern": [
        "ACCEPT: 명백한 위반 (PIT C1-15 hard / Hard Constraint / AX axiom hard FAIL) → spec 수정",
        "PARTIAL: 부분 인정 → 보완 자료 + 일부 변경",
        "REBUTTAL: 명시적 근거 (학술 1+ 인용 + L-code 1+ + 정량 data) 3축"
      ],
      "self_rationalization_grep": [
        "미미",
        "관행적",
        "실무적",
        "보수적이면 OK",
        "대부분 결과 동일",
        "이미 반영"
      ],
      "qlead_escalate_triggers": [
        "HIGH severity ≥ 5",
        "AX axiom hard FAIL ≥ 3",
        "PIT C1 (lockbox / lookahead) 위반 발견",
        "Codex stance=REJECT + agent rebuttal ALL"
      ]
    },
    {
      "stage": 5,
      "name": "final_write",
      "actor": "agent",
      "tool": "Write|Edit",
      "output_path_pattern": "qepm/mailbox/worktask/{WT_ID}/{role}_package.json",
      "trigger_hook": "codex_round_pre_enforcer.sh",
      "trigger_event": "PreToolUse[Write|Edit]",
      "validation_required": [
        "{role}_package_draft.json EXISTS in same dir",
        "codex_critic_response_{role}.json EXISTS in same dir"
      ],
      "block_decision_if_validation_fails": true,
      "block_reason_template": "CODEX_CRITIC_ROUND_REQUIRED (v6.0 의무 단계, L-269): role={role} | draft={present|missing} | critic_response={present|missing}. 절차: (1) {role}_package_draft.json Write → (2) PostToolUse codex auto-spawn 대기 → (3) codex_critic_response_{role}.json 도착 → (4) challenge_note.md 기록 → (5) {role}_package.json finalize.",
      "waiver_path": "challenge_note.md::codex_critic_skip_waiver"
    }
  ],

  "subagent_stop_check": {
    "stage": "6 (post-completion)",
    "trigger_event": "SubagentStop",
    "validation_required": [
      "{role}_package.json EXISTS",
      "challenge_note.md EXISTS (or role-specific equivalent)"
    ],
    "behavior": "missing 시 governance_log warn + Q-Lead notify (block 안 함, agent already exited)"
  },

  "four_layer_enforcement_matrix": {
    "L1_qlead_awareness": {
      "responsible": "Q-Lead",
      "mechanism": "CLAUDE.md autoload + 02_Infrastructure/docs/rules/codex-round.md"
    },
    "L2_spawn_prompt": {
      "responsible": "Q-Lead",
      "mechanism": "qlead_spawn_template.md + Agent tool prompt 5단계 흐름 명시 의무"
    },
    "L3_agent_self_obligation": {
      "responsible": "agent",
      "mechanism": ".claude/agents/{role}.md line 22+ 'v6.0 의무 단계 영구' 명시"
    },
    "L4_hook_enforce": {
      "responsible": "system",
      "mechanism": "codex_round_auto_trigger.sh (Post _draft) + codex_round_pre_enforcer.sh (Pre final)"
    },
    "minimum_layers_active": 3,
    "session_75_lesson": "L1+L2+L4 부재 시 우회 자연 발생 (L-269 사례)"
  },

  "waiver_protocol": {
    "where": "challenge_note.md::codex_critic_skip_waiver",
    "fields_required": [
      "reason (≥ 50 chars)",
      "도훈 override 인용 OR Q-Lead urgent 명시",
      "사후 Layer 2 sweep 의무 ('Rscript 02_Infrastructure/ops/cert_backfill_audit.R --target={WT_ID} --manual')"
    ]
  }
}
