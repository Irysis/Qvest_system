{
  "_meta": {
    "version": "1.0.0",
    "created": "2026-05-15",
    "mandate": "도훈 — 데이터 최신화 silent gap 영구 차단",
    "schema": {
      "path": "cache file path relative to project root",
      "producer": "R script that builds this cache (path relative to project root)",
      "entry_fn": "function name to call (or '(source)' if top-level script)",
      "schedule": "daily | weekly | monthly | on_demand",
      "date_col": "column name for max(Date) freshness check (null if not applicable)",
      "file_pattern": "OPTIONAL (2026-06-10 P1) — set for directory caches (path=dir). regex matching member files; freshness = latest matching file. date_col set: max(date_col) of latest file / date_col null: month-end of YYYYMM in latest filename",
      "max_lag_days": "stale alert threshold (days). null if not applicable",
      "depends_on": "list of upstream cache files (topological order)",
      "args": "optional R named-list args passed to entry_fn",
      "tier": "1=critical (regime/MSM/strategy), 2=important (factor/macro), 3=research"
    }
  },
  "caches": [
    {
      "path": ".cache/RAWDATA.parquet",
      "producer": "02_Infrastructure/data/krx_data_collector.R",
      "entry_fn": "(orchestrated_via_daily_refresh_steps_0_to_3)",
      "schedule": "daily",
      "date_col": "Date",
      "max_lag_days": 1,
      "depends_on": [],
      "tier": 1
    },
    {
      "path": ".cache/benchmark.parquet",
      "producer": "02_Infrastructure/data/krx_data_collector.R",
      "entry_fn": "(orchestrated)",
      "schedule": "daily",
      "date_col": "Date",
      "max_lag_days": 1,
      "depends_on": [],
      "tier": 1
    },
    {
      "path": ".cache/universe.parquet",
      "producer": "02_Infrastructure/data/krx_update_universe.R",
      "entry_fn": "(source)",
      "schedule": "monthly",
      "date_col": "Date",
      "max_lag_days": 35,
      "depends_on": [".cache/RAWDATA.parquet"],
      "tier": 1,
      "_note": "universe는 월말 snapshot만 추가 — krx_update_universe()가 'No new month-ends' 시 skip. 2026-05-24 도훈 audit: schedule=daily mislabel 정정 (lag false-CRITICAL)"
    },
