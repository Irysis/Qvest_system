#!/usr/bin/env bash
# qvest_v8_ready — v8.0 Design Readiness Gate CLI
#
# Usage:
#   qvest_v8_ready                  # default (strict=TRUE, write report)
#   qvest_v8_ready --strict          # 명시 strict
#   qvest_v8_ready --no-write        # report/soak_log 안 씀, production 무손상
#   qvest_v8_ready --json            # JSON only output
#   qvest_v8_ready --strict --json   # 조합
#
# Exit code:
#   0 = PASS
#   1 = FAIL
#   2 = WARN only

set -euo pipefail
trap 'exit 1' ERR

PROJ_DIR="${CLAUDE_PROJECT_DIR:-$(pwd)}"
GATE_R="$PROJ_DIR/02_Infrastructure/validation/v8_readiness_gate.R"

if [ ! -f "$GATE_R" ]; then
  echo "[ERROR] gate not found: $GATE_R" >&2
  exit 1
fi

STRICT=TRUE
JSON_ONLY=0
NO_WRITE=FALSE
WRITE_REPORT=TRUE
for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=TRUE ;;
    --no-strict) STRICT=FALSE ;;
    --json) JSON_ONLY=1 ;;
    --no-write) NO_WRITE=TRUE; WRITE_REPORT=FALSE ;;
  esac
done

R_CMD=$(cat <<RSCRIPT
suppressMessages(source("02_Infrastructure/validation/v8_readiness_gate.R"))
res <- run_v8_readiness_gate(
  project_root = getwd(),
  write_report = $WRITE_REPORT,
  strict = $STRICT,
  no_write = $NO_WRITE
)
suppressWarnings(library(jsonlite))
cat(toJSON(res, auto_unbox = TRUE, pretty = TRUE, null = "null"))
RSCRIPT
)

# cd into PROJ first to avoid 한글 path env-string shell escape (run from PROJ_DIR)
JSON_OUT=$(cd "$PROJ_DIR" && Rscript -e "$R_CMD" 2>/tmp/qvest_v8_ready_stderr.log)

if [ "$JSON_ONLY" -eq 1 ]; then
  echo "$JSON_OUT"
else
  OVERALL=$(echo "$JSON_OUT" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("overall","?"))')
  READY=$(echo "$JSON_OUT" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("ready_for_v8_design",False))')
  echo "============================================================"
  echo "Qvest v8.0 Design Readiness Gate"
  echo "============================================================"
  echo "Overall: $OVERALL"
  echo "Ready for v8 design: $READY"
  echo ""
  echo "$JSON_OUT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
s = d.get('summary', {})
print(f\"Summary: {s.get('pass',0)} pass / {s.get('fail',0)} fail / {s.get('warn',0)} warn / {s.get('skip',0)} skip\")
print()
print('Checks:')
for c in d.get('checks', []):
    glyph = {'PASS':'✅','FAIL':'❌','WARN':'⚠️','SKIP':'⏸'}.get(c['status'], '?')
    print(f\"  {glyph} {c['id']:<28} [{c['status']}] {c['details'][:80]}\")
print()
print('Next actions:')
na = d.get('next_actions', [])
if isinstance(na, str):
    na = [na]
for a in na:
    print(f'  - {a}')
report = d.get('report_paths', {})
if report:
    print()
    print(f\"Report: {report.get('latest','?')}\")
"
fi

# Exit code
case "$(echo "$JSON_OUT" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("overall","?"))')" in
  PASS) exit 0 ;;
  FAIL) exit 1 ;;
  WARN) exit 2 ;;
  *) exit 1 ;;
esac
