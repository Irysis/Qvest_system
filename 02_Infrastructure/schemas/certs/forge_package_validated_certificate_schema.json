{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qvest-v7.0/forge_package_validated_certificate",
  "title": "Forge Package Validated Certificate",
  "description": "Issued when forge_package 8-field PASS. Plan Sprint 3 Schema #10.",
  "type": "object",
  "required": ["issued", "wt_id", "issued_at", "issued_by", "charter_ref"],
  "properties": {
    "issued": { "type": "boolean" },
    "wt_id": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string" },
    "charter_ref": { "type": "string" },
    "validated_fields_count": { "type": "integer", "minimum": 0 },
    "non_issuance_reason": { "type": ["string", "null"] },
    "remediation": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
