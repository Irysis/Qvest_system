{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qvest-v7.0/alpha_discovery_certificate",
  "title": "Alpha Discovery Certificate",
  "description": "Issued when 4 AND eligibility met. Plan Sprint 3 Schema #7.",
  "type": "object",
  "required": ["issued", "wt_id", "issued_at", "issued_by", "charter_ref"],
  "properties": {
    "issued": { "type": "boolean" },
    "wt_id": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string" },
    "charter_ref": { "type": "string" },
    "alpha_inheritance_cor": { "type": ["number", "null"] },
    "mechanism_cited_chars": { "type": ["integer", "null"] },
    "factor_specs_count": { "type": ["integer", "null"] },
    "factor_specs_new_count": { "type": ["integer", "null"] },
    "harvey_t_specs_pass_count": { "type": ["integer", "null"] },
    "non_issuance_reason": { "type": ["string", "null"] },
    "remediation": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
