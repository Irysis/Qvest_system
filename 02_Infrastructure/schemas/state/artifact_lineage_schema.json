{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qvest-v7.0/artifact_lineage",
  "title": "Artifact Lineage",
  "description": "alpha → risk → optimizer → forge → judge → governor chain. Plan Sprint 3 Schema #14.",
  "type": "object",
  "required": ["wt_id", "lineage"],
  "properties": {
    "wt_id": { "type": "string", "pattern": "^WT-[DPSH][0-9]{8}_[0-9]{3}$" },
    "discovery_of": { "type": ["string", "null"] },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "artifact_path"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["alpha", "risk", "optimizer", "forge", "judge", "governor"]
          },
          "artifact_path": { "type": "string" },
          "generated_at": { "type": ["string", "null"], "format": "date-time" },
          "draft_path": { "type": ["string", "null"] },
          "codex_response_path": { "type": ["string", "null"] },
          "challenge_note_path": { "type": ["string", "null"] }
        }
      }
    }
  },
  "additionalProperties": true
}
