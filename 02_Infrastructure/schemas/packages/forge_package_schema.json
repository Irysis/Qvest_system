{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qvest-v7.0/forge_package",
  "title": "Forge Package",
  "description": "forge final output (Charter §9 SoT 8 mandatory fields). Plan Sprint 3 Schema #4.",
  "type": "object",
  "required": [
    "task_id", "backtest_summary",
    "sr_realized_share_based",
    "measurement_basis_primary",
    "weights_csv_unique_dates_count",
    "alpha_sig_dates_count",
    "schedule_density_ratio",
    "schedule_density_pass",
    "pure_function_violation"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^WT-[DPSH][0-9]{8}_[0-9]{3}$" },
    "backtest_summary": { "type": "object" },
    "sr_realized_share_based": { "type": "number" },
    "measurement_basis_primary": {
      "type": "string",
      "enum": ["forge_realized_share_based"]
    },
    "weights_csv_unique_dates_count": { "type": "integer", "minimum": 0 },
    "alpha_sig_dates_count": { "type": "integer", "minimum": 0 },
    "schedule_density_ratio": { "type": "number", "minimum": 0, "maximum": 1.5 },
    "schedule_density_pass": { "type": "boolean" },
    "pure_function_violation": { "type": ["boolean", "string", "null"] }
  },
  "additionalProperties": true
}
