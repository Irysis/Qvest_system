{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qvest-v7.0/risk_package",
  "title": "Risk Package",
  "description": "risk-research final output. Plan Sprint 3 Schema #2.",
  "type": "object",
  "required": ["task_id", "as_of_date", "factor_covariance_ref", "risk_summary", "diagnostics"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^WT-[DPSH][0-9]{8}_[0-9]{3}$" },
    "as_of_date": { "type": "string", "format": "date" },
    "factor_covariance_ref": { "type": "string" },
    "risk_summary": { "type": "object" },
    "diagnostics": { "type": "object" },
    "sigma_method": { "type": "string", "description": "e.g. Sample / Ledoit-Wolf / Gerber / DCC-Copula" },
    "cond_post_shrink": { "type": "number" },
    "tail_risk": { "type": "object" },
    "crowding_diagnostic": { "type": "object" }
  },
  "additionalProperties": true
}
